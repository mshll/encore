# Required
SPOTIFY_CLIENT_ID=your-spotify-client-id

# Origin the browser uses. Passkeys are bound to its hostname; cookies are Secure when it is https.
PUBLIC_BASE_URL=http://localhost:8888
# Defaults to PUBLIC_BASE_URL + /callback. Locally Spotify only allows 127.0.0.1, so set it explicitly.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Registers the first passkey. Generate with: openssl rand -hex 24 (min 24 chars). Unset after setup if you like.
SETUP_TOKEN=
# Bearer token accepted only on /api/tags/* and POST /api/import. Min 24 chars. Unset disables bearer access.
ADMIN_TOKEN=

HOST=127.0.0.1
PORT=8888
DATABASE_PATH=./data/encore.db
WEB_DIST=./web/dist
# IANA zone for day and hour buckets, e.g. Europe/London
TIMEZONE=UTC
# Two-letter country code for trips; unset uses the country with the most plays
HOME_COUNTRY=
JOBS_ENABLED=true
POLL_INTERVAL_SECONDS=300
ENRICH_INTERVAL_SECONDS=120
ENRICH_BATCH_SIZE=1
ART_INTERVAL_SECONDS=4
QUOTA_BACKOFF_HOURS=12
# Every Spotify Web API call goes through one queue, at least this many ms apart; requests go before jobs
SPOTIFY_MIN_INTERVAL_MS=2000

# Jobs to skip, comma separated: poll, enrich, art, watch, radar, library
JOBS_DISABLED=
# Player watcher: poll cadence while playing, while idle, and the longest back-off after a 429
WATCHER_ACTIVE_SECONDS=15
WATCHER_IDLE_SECONDS=60
WATCHER_BACKOFF_MAX_SECONDS=900
# DJ session: consecutive skips that trigger a re-plan
DJ_SKIP_TRIGGER=2
# deterministic or llm (Claude, with the deterministic plan as fallback on any error or timeout)
DJ_REPLANNER=deterministic
DJ_REPLAN_TIMEOUT_SECONDS=20
# Release radar: artists with at least this many listens in the last 12 months, checked at most every RADAR_RECHECK_DAYS
RADAR_MIN_LISTENS=20
RADAR_INTERVAL_MINUTES=60
RADAR_ARTISTS_PER_RUN=2
RADAR_RECHECK_DAYS=7
# First check of an artist flags releases from this many days back as new
RADAR_BASELINE_DAYS=30
# Saved songs and own playlists: one full pass every LIBRARY_SYNC_HOURS, one page call every LIBRARY_PAGE_SECONDS
LIBRARY_SYNC_HOURS=24
LIBRARY_PAGE_SECONDS=20

# Discord. Interactions need APPLICATION_ID, PUBLIC_KEY and OWNER_ID. Command registration also needs BOT_TOKEN and GUILD_ID;
# weekly picks, digest and recap posts need BOT_TOKEN and CHANNEL_ID.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_OWNER_ID=

# Bearer token for the MCP endpoint at /mcp. Min 24 chars. Unset disables /mcp.
MCP_TOKEN=
# Claude features (sets, picks, ask, notes, digests, DJ re-plans). Unset key disables them.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Optional JSON price overrides in USD per million tokens, e.g. {"claude-opus-5-5":{"input":4,"output":20,"cacheWrite5m":5,"cacheWrite1h":8,"cacheRead":0.2}}
LLM_PRICES=
MONTHLY_BUDGET_USD=100
PICKS_PER_WEEK=5
PICKS_FAR_OUT=1
# ISO weekday (1 = Monday, 5 = Friday) and local hour
PICKS_WEEKDAY=5
PICKS_HOUR=10
PICKS_PLAYLIST=false
DIGEST_WEEKDAY=5
DIGEST_HOUR=9
